# Connected mode is required; the server fails closed until required settings are configured.
EA_REFERRAL_MODE=connected
APP_ORIGIN=http://localhost:3000

# Server side only. Do not prefix these with NEXT_PUBLIC_ or expose them to browser code.
SUPABASE_URL=https://your-project-ref.supabase.co # Placeholder: replace with your Supabase project URL.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me # Placeholder: replace with your Supabase publishable key.
SUPABASE_SECRET_KEY=sb_secret_replace_me # Placeholder secret; server-side only.
ADMIN_USER_ID=00000000-0000-4000-8000-000000000001 # Placeholder UUID for the configured admin user.

# Optional OpenRouter assessment. Keep the key server-side. All configured
# models must use the :free variant; paid fallbacks are rejected by the app.
OPENROUTER_API_KEY=replace_with_openrouter_api_key # Placeholder secret; server-side only.
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,liquid/lfm-3-1.7b:free,xingchen-agi/xing4.0-29b-a4b:free,nvidia/nemotron-3.5-super-vl:free

# Resend notifications are unavailable until these values are configured.
RESEND_API_KEY=replace_with_resend_api_key # Placeholder secret; server-side only.
RESEND_FROM_EMAIL=referrals@example.invalid
