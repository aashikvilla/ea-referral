# Supabase project URL and publishable key may be used by browser-safe clients.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Never expose this key to browser code or commit real values.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Resend transactional email. Production sending requires a verified sender domain.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=EA Referral <referrals@example.com>

# Optional for local AI Gateway requests; Vercel deployments can use Vercel OIDC.
AI_GATEWAY_API_KEY=replace_me
AI_GATEWAY_MODEL=provider/model
