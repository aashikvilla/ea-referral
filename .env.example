# Runtime mode defaults to demo in the UI; server APIs stay unavailable unless connected is configured.
EA_REFERRAL_MODE=demo
APP_ORIGIN=http://localhost:3000

# Server side only. Do not prefix these with NEXT_PUBLIC_ or expose them to browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
ADMIN_USER_ID=00000000-0000-4000-8000-000000000001

# Email sending is intentionally not configured in this build.
